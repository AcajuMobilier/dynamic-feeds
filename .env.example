# Copiază acest fișier ca ".env" (exact așa, fără ".example") în același folder și completează valorile.
# ".env" este în .gitignore și NU ajunge niciodată în git. Nu trimite niciodată aceste valori în chat.

# 1) Handle-ul magazinului, așa cum apare în adresa adminului Shopify:
#    https://admin.shopify.com/store/<handle>   ->   SHOPIFY_STORE=<handle>.myshopify.com
SHOPIFY_STORE=mystore.myshopify.com

 
 
SHOPIFY_TOKEN=token

