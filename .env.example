# Copiază acest fișier ca ".env" (exact așa, fără ".example") în același folder și completează valorile.
# ".env" este în .gitignore și NU ajunge niciodată în git. Nu trimite niciodată aceste valori în chat.
# Pe GitHub, aceleași nume se pun la Settings -> Secrets and variables -> Actions.

# ocean.ro — handle-ul .myshopify.com al magazinului și tokenul aplicației custom (începe cu shpat_)
SHOPIFY_STORE=handle-ocean.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# acaju.ro — la fel, pentru al doilea magazin
SHOPIFY_STORE_ACAJU=handle-acaju.myshopify.com
SHOPIFY_TOKEN_ACAJU=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
